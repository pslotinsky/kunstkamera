{
  "name": "gemstorm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gemstorm: a fantasy strategy game of rival houses, province management, and tactical battles across Aureth.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write && npm run typecheck",
    "check:ci": "biome check && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "jsdom": "^30.1.3",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "zzfx": "^1.4.0"
  }
}
