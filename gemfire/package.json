{
  "name": "gemfire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch remake of the Koei SNES strategy game Gemfire (learning / craftsmanship project).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write && npm run typecheck",
    "check:ci": "biome check && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "jsdom": "^30.1.3",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "zzfx": "^1.4.0"
  }
}
