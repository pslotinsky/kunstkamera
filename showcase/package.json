{
  "name": "kunstkamera-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:game": "npm --prefix ../gemfire run dev -- --port 5174 --strictPort",
    "build": "npm run typecheck && react-router build && node build/preparePages.ts && npm run build:game",
    "build:game": "npm --prefix ../gemfire run build -- --base ./ --outDir ../showcase/dist/public/gemfire/game --emptyOutDir",
    "preview": "vite preview --config vite.preview.config.ts",
    "typecheck": "fumadocs-mdx && react-router typegen && tsc --noEmit",
    "check": "biome check --write && npm run typecheck",
    "check:ci": "biome check && npm run typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "fumadocs-core": "^16.17.3",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.3",
    "isbot": "^5",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.1"
  }
}
