{
  "name": "kunstkamera-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:game": "npm --prefix ../gemstorm run dev -- --port 5174 --strictPort",
    "build": "npm run build:prototypes && npm run typecheck && react-router build && node build/preparePages.ts",
    "build:game": "npm --prefix ../gemstorm run build -- --base ./ --outDir ../showcase/dist/public/gemstorm/game --emptyOutDir",
    "preview": "vite preview --config vite.preview.config.ts",
    "typecheck": "fumadocs-mdx && react-router typegen && tsc --noEmit",
    "check": "biome check --write && npm run typecheck",
    "check:ci": "biome check && npm run typecheck",
    "predev": "npm run build:prototypes",
    "build:prototypes": "npm --prefix ../debt-dungeon run build -- --base ./"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "fumadocs-core": "^16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "^16.19.7",
    "isbot": "^5",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@react-router/dev": "^8.5.2",
    "@react-router/node": "^8.4.0",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8"
  }
}
