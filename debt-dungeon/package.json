{
  "name": "debt-dungeon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write && npm run typecheck",
    "check:ci": "biome check && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
